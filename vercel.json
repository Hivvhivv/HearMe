{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "installCommand": "npm install && npm install --prefix backend --omit=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",

  "functions": {
    "api/[...path].js": {
      "maxDuration": 30
    }
  },

  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
