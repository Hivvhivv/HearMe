# ======================================================
# HearMe Frontend -- contoh konfigurasi
#
# Salin menjadi .env di root project.
# File .env TIDAK ikut ke git (lihat .gitignore).
# ======================================================

# Alamat backend, HARUS diakhiri dengan /api
#
# Dev di laptop sendiri (boleh dikosongkan, ini default):
#   VITE_API_URL=http://localhost:5000/api
#
# Tes dari HP / device kedua di jaringan yang sama:
# ganti dengan IP LAN laptop kamu. Cari dengan
# `ipconfig` -> IPv4 Address.
#
#   VITE_API_URL=http://192.168.1.5:5000/api
#
# CATATAN: "localhost" di HP berarti HP itu sendiri,
# bukan laptop kamu. Itulah sebabnya API harus memakai
# IP LAN, bukan localhost, saat diakses dari device lain.
VITE_API_URL=http://localhost:5000/api
