# ======================================================
# HearMe Frontend -- contoh konfigurasi
#
# Salin menjadi .env di root project HANYA kalau kamu
# benar-benar perlu mengubah salah satu nilai di bawah.
# File .env TIDAK ikut ke git (lihat .gitignore).
# ======================================================


# ------------------------------------------------------
# VITE_API_URL  (KOSONGKAN SAJA / jangan diisi)
# ------------------------------------------------------
#
# Secara default frontend memakai URL RELATIF "/api".
#
# Itu sengaja, dan sebaiknya dibiarkan:
#
#   - Dev        : Vite mem-proxy /api -> localhost:5000
#                  (lihat vite.config.ts)
#   - Produksi   : vercel.json me-rewrite /api/* ke
#                  serverless function
#
# Akibatnya frontend dan API selalu SAME-ORIGIN, sehingga:
#
#   - akses dari HP lewat IP LAN langsung jalan, tanpa
#     mengisi apa pun di file ini
#   - tidak ada masalah CORS
#   - cookie refresh token tidak bergantung pada setelan
#     SameSite lintas port/domain
#
# ISI HANYA kalau backend benar-benar ada di host LAIN,
# misalnya di-deploy terpisah:
#
#   VITE_API_URL=https://api-hearme.contoh.com/api
#
# JANGAN diisi "http://localhost:5000/api" — nilai itu
# akan ikut ter-build, dan di HP maupun di Vercel
# "localhost" berarti perangkat ITU SENDIRI. Itulah
# penyebab "failed to fetch" yang paling umum.
#
# VITE_API_URL=


# ------------------------------------------------------
# BACKEND_URL  (hanya untuk dev server)
# ------------------------------------------------------
#
# Target proxy Vite. Default http://localhost:5000.
# Ubah kalau backend dijalankan di port/host lain.
#
# BACKEND_URL=http://localhost:5000
