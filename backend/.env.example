# ======================================================
# HearMe Backend -- contoh konfigurasi
#
# Salin file ini menjadi backend/.env lalu isi nilainya.
# File .env TIDAK ikut ke git (lihat .gitignore).
# ======================================================

# Port backend. Frontend default menunjuk ke port ini.
PORT=5000

# MongoDB Atlas connection string.
# Ambil dari Atlas > Cluster > Connect > Drivers.
# Pastikan IP kamu ada di Atlas > Network Access.
#
# PENTING -- password WAJIB di-percent-encode.
#
# Driver membaca URI, jadi karakter yang punya arti khusus
# di URI harus diubah. Yang paling sering menjerat: "@",
# karena driver memotong di "@" PERTAMA untuk memisahkan
# kredensial dari host. Password "@Nadi@Nof280405" yang
# ditempel apa adanya terbaca sebagai password "" dengan
# host "Nadi@Nof280405@cluster0..." -- hasilnya:
#
#   MongoServerError: bad auth : authentication failed
#
# Tabel cepat:
#
#   @ -> %40     : -> %3A     / -> %2F
#   # -> %23     ? -> %3F     % -> %25
#
# Jadi "@Nadi@Nof280405" ditulis "%40Nadi%40Nof280405".
#
# Cara aman membuatnya:
#   node -e "console.log(encodeURIComponent('password-mu'))"
#
# Aturan yang sama berlaku saat menempel URI ini ke
# Environment Variables di Vercel.
#
# Jangan sertakan tanda <> dari template Atlas.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/hearme?retryWrites=true&w=majority

# Secret untuk menandatangani JWT. WAJIB diganti.
# Contoh membuat yang acak:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti_dengan_string_acak_yang_panjang

# Masa hidup access token.
JWT_EXPIRES_IN=1d

# Origin frontend yang diizinkan, dipisah koma.
# Kosongkan untuk mengizinkan semua origin (hanya dev).
#
# Untuk tes dari HP di jaringan yang sama, tambahkan
# IP LAN laptop kamu:
#   CORS_ORIGINS=http://localhost:8443,http://192.168.1.5:8443
CORS_ORIGINS=
